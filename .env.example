# ============================================================
# Giftly — variables de entorno
# Copiá este archivo a .env y completá los valores.
# .env NUNCA se commitea (ya está en .gitignore).
# ============================================================

# --- Supabase (necesario para el modo real: Postgres + auth anónima + Realtime)
# Crear proyecto en https://supabase.com/dashboard
# Project Settings > API: URL + anon key + service_role key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sin Supabase configurado, la app corre en "modo local" (archivo JSON en .data/)
# para que el flujo completo funcione igual desde el primer día.

# Forzar modo local aunque haya keys (ej: proyecto de Supabase pausado).
# Borrar esta línea (o dejarla vacía) para usar Supabase.
NEXT_PUBLIC_GIFTLY_DATA_MODE=

# --- OpenAI (recomendaciones reales; sin key usa fallback mock automático)
OPENAI_API_KEY=

# --- Mercado Libre (precios/imágenes reales)
# Crear app en https://developers.mercadolibre.com.ar/ y generar
# client_id + client_secret. Sin estas credenciales los precios son estimados.
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# --- App
# URL pública (para Vercel: la que asigna el deploy)
NEXT_PUBLIC_APP_URL=http://localhost:3000